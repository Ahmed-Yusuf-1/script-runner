{
  "name": "script-runner",
  "version": "0.1.0",
  "description": "GUI script runner — build automation flows and run them with Playwright",
  "main": "./out/main/index.js",
  "author": "",
  "license": "MIT",
  "scripts": {
    "dev": "electron-vite dev",
