{
  "name": "script-runner",
  "version": "0.2.0",
  "description": "Desktop app for building browser automations step by step, without code, and running them with Playwright",
  "main": "./out/main/index.js",
  "author": "Ahmed Yusuf",
  "license": "MIT",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "tsx --test tests/*.test.ts",
    "check": "npm run typecheck && npm test && npm run build",
    "smoke": "tsx src/main/engine/smoke.ts",
    "smoke:offline": "npm run smoke:repeat && npm run smoke:download && npm run smoke:newtab && npm run smoke:match && npm run smoke:back && npm run smoke:nth && npm run smoke:autoinc && npm run smoke:waitafter && npm run smoke:tabfollow && npm run smoke:closetab && npm run smoke:whitelist && npm run smoke:dlstart && npm run smoke:actions2 && npm run smoke:control && npm run smoke:dlname && npm run smoke:realworld",
    "smoke:repeat": "tsx src/main/engine/smoke-repeat.ts",
    "smoke:download": "tsx src/main/engine/smoke-download.ts",
    "smoke:adblock": "tsx src/main/engine/smoke-adblock.ts",
    "smoke:newtab": "tsx src/main/engine/smoke-newtab.ts",
    "smoke:match": "tsx src/main/engine/smoke-match.ts",
    "smoke:back": "tsx src/main/engine/smoke-back.ts",
    "smoke:nth": "tsx src/main/engine/smoke-nth.ts",
    "smoke:autoinc": "tsx src/main/engine/smoke-autoinc.ts",
    "smoke:waitafter": "tsx src/main/engine/smoke-waitafter.ts",
    "smoke:profile": "tsx src/main/engine/smoke-profile.ts",
    "smoke:tabfollow": "tsx src/main/engine/smoke-tabfollow.ts",
    "smoke:closetab": "tsx src/main/engine/smoke-closetab.ts",
    "smoke:whitelist": "tsx src/main/engine/smoke-whitelist.ts",
    "smoke:dlstart": "tsx src/main/engine/smoke-dlstart.ts",
    "postinstall": "playwright install chromium",
    "install-browsers": "node -e \"process.env.PLAYWRIGHT_BROWSERS_PATH='playwright-browsers'; require('child_process').execSync('npx playwright install chromium', {stdio: 'inherit'})\"",
    "dist": "npm run build && npm run install-browsers && electron-builder",
    "smoke:actions2": "tsx src/main/engine/smoke-actions2.ts",
    "smoke:control": "tsx src/main/engine/smoke-control.ts",
    "smoke:dlname": "tsx src/main/engine/smoke-dlname.ts",
    "dist:win": "npm run build && npm run install-browsers && electron-builder --win",
    "dist:mac": "npm run build && npm run install-browsers && electron-builder --mac",
    "dist:linux": "npm run build && npm run install-browsers && electron-builder --linux",
    "smoke:realworld": "tsx src/main/engine/smoke-realworld.ts"
  },
  "dependencies": {
    "@ghostery/adblocker-playwright": "^2.17.3",
    "playwright": "^1.48.0"
  },
  "devDependencies": {
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@types/node": "^22.7.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "electron": "^33.4.11",
    "electron-builder": "^26.8.1",
    "electron-vite": "^2.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vite": "^5.4.0"
  },
  "build": {
    "appId": "com.ahmed.scriptrunner",
    "productName": "Script Runner",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "playwright-browsers",
        "to": "playwright-browsers",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Script Runner"
    },
    "mac": {
      "target": "dmg",
      "category": "public.app-category.developer-tools",
      "icon": "build/icon.png"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Development",
      "icon": "build/icon.png",
      "maintainer": "Ahmed Yusuf",
      "synopsis": "Browser automations without code"
    },
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}"
  },
  "homepage": "https://github.com/Ahmed-Yusuf-1/script-runner"
}
